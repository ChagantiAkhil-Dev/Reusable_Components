    <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="' Check if worksheet exists before attempting deletion.&#xA;' Prevent deletion when workbook contains only one worksheet.&#xA;' Disable DisplayAlerts to suppress Excel's confirmation prompt.&#xA;' Save workbook only after successful deletion.&#xA;' Release Workbook and Excel COM objects to avoid orphaned EXCEL.EXE processes.&#xA;' Run Garbage Collection to clean up remaining COM references." Code="' Declare Excel objects&#xA;Dim xlApp As Microsoft.Office.Interop.Excel.Application = Nothing&#xA;Dim wb As Microsoft.Office.Interop.Excel.Workbook = Nothing&#xA;&#xA;Try&#xA;    ' Open Excel and workbook&#xA;    xlApp = New Microsoft.Office.Interop.Excel.Application&#xA;    wb = xlApp.Workbooks.Open(str_Filepath)&#xA;    ' Prevent Excel confirmation dialogs&#xA;    xlApp.DisplayAlerts = False&#xA;    Dim ws As Microsoft.Office.Interop.Excel.Worksheet = Nothing&#xA;    ' Find the worksheet by name&#xA;    For Each sheet As Microsoft.Office.Interop.Excel.Worksheet In wb.Worksheets&#xA;        If sheet.Name.Equals(str_Sheetname, StringComparison.OrdinalIgnoreCase) Then&#xA;            ws = sheet&#xA;            Exit For&#xA;        End If&#xA;        Runtime.InteropServices.Marshal.ReleaseComObject(sheet)&#xA;    Next&#xA;&#xA;    If ws Is Nothing Then&#xA;        str_Status = &quot;Error: Worksheet '&quot; &amp; str_Sheetname &amp; &quot;' not found.&quot;&#xA;    ElseIf wb.Worksheets.Count = 1 Then&#xA;        str_Status = &quot;Error: Cannot delete worksheet '&quot; &amp; str_Sheetname &amp; &quot;' because it is the last worksheet.&quot;&#xA;    Else&#xA;        ' Delete worksheet&#xA;        ws.Delete()&#xA;        ' Save changes&#xA;        wb.Save()&#xA;        str_Status = &quot;Worksheet '&quot; &amp; str_Sheetname &amp; &quot;' deleted successfully.&quot;&#xA;    End If&#xA;Catch ex As Exception&#xA;    str_Status = &quot;Error: &quot; &amp; ex.Message&#xA;Finally&#xA;    ' Restore alerts&#xA;    If xlApp IsNot Nothing Then&#xA;        xlApp.DisplayAlerts = True&#xA;    End If&#xA;    ' Close workbook&#xA;    If wb IsNot Nothing Then&#xA;        wb.Close(False)&#xA;        Runtime.InteropServices.Marshal.ReleaseComObject(wb)&#xA;    End If&#xA;    ' Quit Excel&#xA;    If xlApp IsNot Nothing Then&#xA;        xlApp.Quit()&#xA;        Runtime.InteropServices.Marshal.ReleaseComObject(xlApp)&#xA;    End If&#xA;    GC.Collect()&#xA;    GC.WaitForPendingFinalizers()&#xA;End Try" DisplayName="Invoke code - Delete Sheet" sap:VirtualizedContainerService.HintSize="452,595" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
