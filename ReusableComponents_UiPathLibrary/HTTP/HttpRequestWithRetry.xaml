  </Sequence.Variables>
  <ui:LogMessage DisplayName="Log Message - Start" Level="Info" Message="[&quot;HttpRequestWithRetry started processing&quot;]" />
  <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Invoke Code - HTTP request with retry" Code="out_int_StatusCode = 0&#xD;&#xA;out_str_ResponseBody = &quot;&quot;&#xD;&#xA;out_int_AttemptCount = 0&#xD;&#xA;out_str_ErrorMessage = &quot;&quot;&#xD;&#xA;str_ErrorType = &quot;&quot;&#xD;&#xA;str_SafeUrl = &quot;&quot;&#xD;&#xA;&#xD;&#xA;Dim method As String = If(String.IsNullOrWhiteSpace(in_str_Method), &quot;GET&quot;, in_str_Method.Trim().ToUpper())&#xD;&#xA;Dim maxAttempts As Integer = If(in_int_MaxAttempts &lt;= 0, 3, in_int_MaxAttempts)&#xD;&#xA;Dim baseDelay As Integer = If(in_int_RetryDelaySeconds &lt;= 0, 2, in_int_RetryDelaySeconds)&#xD;&#xA;Dim timeoutSec As Integer = If(in_int_TimeoutSeconds &lt;= 0, 100, in_int_TimeoutSeconds)&#xD;&#xA;Dim unsafeMethod As Boolean = (method = &quot;POST&quot; OrElse method = &quot;PATCH&quot;)&#xD;&#xA;Dim uriObj As Uri = Nothing&#xD;&#xA;&#xD;&#xA;If Not Uri.TryCreate(If(in_str_Url, &quot;&quot;).Trim(), UriKind.Absolute, uriObj) Then&#xD;&#xA;    out_str_ErrorMessage = &quot;Invalid or empty URL.&quot;&#xD;&#xA;    str_ErrorType = &quot;BRE&quot;&#xD;&#xA;Else&#xD;&#xA;    str_SafeUrl = uriObj.GetLeftPart(UriPartial.Path)&#xD;&#xA;    Dim rand As New Random()&#xD;&#xA;    Dim attempt As Integer = 0&#xD;&#xA;    Dim done As Boolean = False&#xD;&#xA;&#xD;&#xA;    While Not done AndAlso attempt &lt; maxAttempts&#xD;&#xA;        attempt += 1&#xD;&#xA;        out_int_AttemptCount = attempt&#xD;&#xA;        Dim retryable As Boolean = False&#xD;&#xA;        Dim waitSec As Double = 0&#xD;&#xA;&#xD;&#xA;        Try&#xD;&#xA;            Using client As New System.Net.Http.HttpClient()&#xD;&#xA;                client.Timeout = TimeSpan.FromSeconds(timeoutSec)&#xD;&#xA;                Using req As New System.Net.Http.HttpRequestMessage(New System.Net.Http.HttpMethod(method), uriObj)&#xD;&#xA;                    If in_dict_Headers IsNot Nothing Then&#xD;&#xA;                        For Each kv As KeyValuePair(Of String, String) In in_dict_Headers&#xD;&#xA;                            req.Headers.TryAddWithoutValidation(kv.Key, kv.Value)&#xD;&#xA;                        Next&#xD;&#xA;                    End If&#xD;&#xA;                    If Not String.IsNullOrEmpty(in_str_Body) Then&#xD;&#xA;                        req.Content = New System.Net.Http.StringContent(in_str_Body, System.Text.Encoding.UTF8, If(String.IsNullOrWhiteSpace(in_str_ContentType), &quot;application/json&quot;, in_str_ContentType))&#xD;&#xA;                    End If&#xD;&#xA;&#xD;&#xA;                    Using resp As System.Net.Http.HttpResponseMessage = client.SendAsync(req).GetAwaiter().GetResult()&#xD;&#xA;                        Dim code As Integer = CInt(resp.StatusCode)&#xD;&#xA;                        out_int_StatusCode = code&#xD;&#xA;                        out_str_ResponseBody = resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xD;&#xA;&#xD;&#xA;                        If code &gt;= 200 AndAlso code &lt; 300 Then&#xD;&#xA;                            out_str_ErrorMessage = &quot;&quot;&#xD;&#xA;                            done = True&#xD;&#xA;                        Else&#xD;&#xA;                            out_str_ErrorMessage = &quot;HTTP &quot; &amp; code.ToString() &amp; &quot; from &quot; &amp; str_SafeUrl&#xD;&#xA;                            Dim transient As Boolean = (code = 408 OrElse code = 429 OrElse code &gt;= 500)&#xD;&#xA;                            If transient AndAlso (code = 429 OrElse Not unsafeMethod OrElse in_bool_RetryUnsafeMethods) Then&#xD;&#xA;                                retryable = True&#xD;&#xA;                                Dim ra As System.Net.Http.Headers.RetryConditionHeaderValue = resp.Headers.RetryAfter&#xD;&#xA;                                If ra IsNot Nothing Then&#xD;&#xA;                                    If ra.Delta.HasValue Then&#xD;&#xA;                                        waitSec = ra.Delta.Value.TotalSeconds&#xD;&#xA;                                    ElseIf ra.Date.HasValue Then&#xD;&#xA;                                        waitSec = Math.Max(0, (ra.Date.Value - DateTimeOffset.UtcNow).TotalSeconds)&#xD;&#xA;                                    End If&#xD;&#xA;                                End If&#xD;&#xA;                            Else&#xD;&#xA;                                done = True&#xD;&#xA;                            End If&#xD;&#xA;                        End If&#xD;&#xA;                    End Using&#xD;&#xA;                End Using&#xD;&#xA;            End Using&#xD;&#xA;        Catch ex As Exception&#xD;&#xA;            out_int_StatusCode = 0&#xD;&#xA;            out_str_ResponseBody = &quot;&quot;&#xD;&#xA;            out_str_ErrorMessage = &quot;Request to &quot; &amp; str_SafeUrl &amp; &quot; failed: &quot; &amp; ex.GetType().Name &amp; &quot; - &quot; &amp; ex.Message&#xD;&#xA;            retryable = (Not unsafeMethod) OrElse in_bool_RetryUnsafeMethods&#xD;&#xA;            If Not retryable Then done = True&#xD;&#xA;        End Try&#xD;&#xA;&#xD;&#xA;        If Not done AndAlso attempt &lt; maxAttempts AndAlso retryable Then&#xD;&#xA;            If waitSec &lt;= 0 Then waitSec = baseDelay * Math.Pow(2, attempt - 1)&#xD;&#xA;            waitSec = Math.Min(waitSec, 60) + rand.NextDouble()&#xD;&#xA;            System.Threading.Thread.Sleep(CInt(waitSec * 1000))&#xD;&#xA;        End If&#xD;&#xA;    End While&#xD;&#xA;&#xD;&#xA;    If out_int_StatusCode &gt;= 200 AndAlso out_int_StatusCode &lt; 300 Then&#xD;&#xA;        str_ErrorType = &quot;&quot;&#xD;&#xA;    ElseIf out_int_StatusCode = 0 OrElse out_int_StatusCode = 401 OrElse out_int_StatusCode = 403 OrElse out_int_StatusCode = 408 OrElse out_int_StatusCode = 429 OrElse out_int_StatusCode &gt;= 500 Then&#xD;&#xA;        str_ErrorType = &quot;SYS&quot;&#xD;&#xA;    Else&#xD;&#xA;        str_ErrorType = &quot;BRE&quot;&#xD;&#xA;    End If&#xD;&#xA;End If" >
