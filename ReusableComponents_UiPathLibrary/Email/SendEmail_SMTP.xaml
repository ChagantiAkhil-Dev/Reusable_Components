    <ui:InvokeCode ContinueOnError="{x:Null}" Code="str_ExcpDetails = &quot;&quot;&#xD;&#xA;Dim smtpClient As System.Net.Mail.SmtpClient = Nothing&#xD;&#xA;Dim mailMsg As System.Net.Mail.MailMessage = Nothing&#xD;&#xA;Try&#xD;&#xA;&#x9;smtpClient = New System.Net.Mail.SmtpClient(in_str_EmailServer)&#xD;&#xA;&#x9;mailMsg = New System.Net.Mail.MailMessage&#xD;&#xA;&#x9;Dim sender As New System.Net.Mail.MailAddress(in_str_EmailSender)&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;'Check if attachment exist&#xD;&#xA;&#x9;If Not String.IsNullOrWhiteSpace(in_str_Attachment) Then&#xD;&#xA;&#x9;    For Each attachmentPath As String In in_str_Attachment.Split(&quot;;&quot;c)&#xD;&#xA;&#x9;        attachmentPath = attachmentPath.Trim()&#xD;&#xA;&#x9;        If Not String.IsNullOrWhiteSpace(attachmentPath) AndAlso IO.File.Exists(attachmentPath) Then&#xD;&#xA;&#x9;            mailMsg.Attachments.Add(New System.Net.Mail.Attachment(attachmentPath))&#xD;&#xA;&#x9;        End If&#xD;&#xA;&#x9;    Next&#xD;&#xA;&#x9;End If&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;'Loop through and add all recipents to the To Collection&#xD;&#xA;&#x9;For Each mail As String In in_str_EmailTo.Split(&quot;;&quot;C)&#xD;&#xA;&#x9; If (Not String.IsNullOrWhiteSpace(mail))&#xD;&#xA;&#x9;  mailMsg.To.Add(mail)&#xD;&#xA;&#x9; End If&#xD;&#xA;&#x9;Next&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;mailmsg.Body  = in_str_EmailBody&#xD;&#xA;&#x9;mailMsg.Subject  = in_str_EmailSubject&#xD;&#xA;&#x9;mailMsg.From  = sender&#xD;&#xA;&#x9;mailMsg.IsBodyHtml = True&#xD;&#xA;&#x9;smtpClient.Port  = Integer.Parse(in_str_EmailPort)&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;'SSL/TLS (optional)&#xD;&#xA;&#x9;smtpClient.EnableSsl = in_bool_EnableSsl&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;'Authentication (optional). The SecureString goes straight into NetworkCredential, never converted to plain text.&#xD;&#xA;&#x9;If Not String.IsNullOrWhiteSpace(in_str_Username) Then&#xD;&#xA;&#x9;    smtpClient.UseDefaultCredentials = False&#xD;&#xA;&#x9;    If in_secureStr_Password IsNot Nothing Then&#xD;&#xA;&#x9;        smtpClient.Credentials = New System.Net.NetworkCredential(in_str_Username, in_secureStr_Password)&#xD;&#xA;&#x9;    Else&#xD;&#xA;&#x9;        smtpClient.Credentials = New System.Net.NetworkCredential(in_str_Username, &quot;&quot;)&#xD;&#xA;&#x9;    End If&#xD;&#xA;&#x9;End If&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;smtpClient.Send(mailMsg)&#xD;&#xA;&#xD;&#xA;Catch e As Exception&#xD;&#xA;&#x9;str_ExcpDetails = &quot;SMTP email failure, due to: &quot;+e.Source+&quot; - &quot;+e.Message&#xD;&#xA;Finally&#xD;&#xA;&#x9;'Dispose releases the attachment files (they stay locked until the message is disposed)&#xD;&#xA;&#x9;If mailMsg IsNot Nothing Then mailMsg.Dispose()&#xD;&#xA;&#x9;If smtpClient IsNot Nothing Then smtpClient.Dispose()&#xD;&#xA;End Try" DisplayName="Code: Send SMTP Email" sap:VirtualizedContainerService.HintSize="452,197" sap2010:WorkflowViewState.IdRef="InvokeCode_4">
