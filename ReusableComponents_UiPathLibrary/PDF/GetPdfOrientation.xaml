    <ui:InvokeCode ContinueOnError="{x:Null}" Code="try&#xA;{&#xA;    // Initialize dictionary to store page number and rotation&#xA;    // Key   = Page Number&#xA;    // Value = Rotation (0, 90, 180, 270)&#xA;    PageRotations = new Dictionary&lt;int, int&gt;();&#xA;    // Open PDF for reading&#xA;    using (PdfReader reader = new PdfReader(InputFilePath))&#xA;    using (PdfDocument pdfDocument = new PdfDocument(reader))&#xA;    {&#xA;        // Loop through all pages&#xA;        for (int p = 1; p &lt;= pdfDocument.GetNumberOfPages(); p++)&#xA;        {&#xA;            // Get the current page's rotation&#xA;            int rotation = pdfDocument.GetPage(p).GetRotation();&#xA;&#xA;            // Store page number and rotation&#xA;            PageRotations.Add(p, rotation);&#xA;        }&#xA;    }&#xA;    // Build a status message containing all page rotations&#xA;    str_Status = string.Join(&#xA;        Environment.NewLine,&#xA;        PageRotations.Select(x =&gt;&#xA;            string.Format(&quot;Page {0}: Rotation {1}°&quot;, x.Key, x.Value))&#xA;    );&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    // Reset output dictionary on failure&#xA;    PageRotations = new Dictionary&lt;int, int&gt;();&#xA;    // Capture error details&#xA;    // Update status&#xA;    str_Status = &quot;Error while reading PDF rotations: &quot; + ex.Message;&#xA;}" DisplayName="Invoke code - Get current orientation" sap:VirtualizedContainerService.HintSize="514,403" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
