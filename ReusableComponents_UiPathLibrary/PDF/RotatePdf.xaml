    <ui:InvokeCode ContinueOnError="{x:Null}" Code="try&#xA;{&#xA;    // Input PDF file path&#xA;    string inputFile = InputFilePath;&#xA;    // Output PDF file path&#xA;    string outputFile = OutputFilePath;&#xA;    // Open the source PDF for reading and create the output PDF&#xA;    using (PdfReader reader = new PdfReader(inputFile))&#xA;    using (PdfWriter writer = new PdfWriter(outputFile))&#xA;    using (PdfDocument pdfDocument = new PdfDocument(reader, writer))&#xA;    {&#xA;        // List to store page rotation results for logging&#xA;        List&lt;string&gt; status = new List&lt;string&gt;();&#xA;        // Loop through each Page Number / Desired Rotation pair&#xA;        // Example: { {1,90}, {3,180}, {5,270} }&#xA;        foreach (KeyValuePair&lt;int, int&gt; item in PagesToRotate)&#xA;        {&#xA;            // Get target page number&#xA;            int pageNumber = item.Key;&#xA;            // Get desired rotation angle (0, 90, 180, 270)&#xA;            int desiredRotation = item.Value;&#xA;            // Validate page number exists in the PDF&#xA;            if (pageNumber &gt;= 1 &amp;&amp;&#xA;                pageNumber &lt;= pdfDocument.GetNumberOfPages())&#xA;            {&#xA;                // Retrieve the page&#xA;                PdfPage page = pdfDocument.GetPage(pageNumber);&#xA;                // Get current page rotation&#xA;                int currentRotation = page.GetRotation();&#xA;                // Apply the new rotation&#xA;                page.SetRotation(desiredRotation);&#xA;                // Store result for logging&#xA;                status.Add(&#xA;                    string.Format(&#xA;                        &quot;Page {0}: {1}° -&gt; {2}°&quot;,&#xA;                        pageNumber,&#xA;                        currentRotation,&#xA;                        desiredRotation&#xA;                    )&#xA;                );&#xA;            }&#xA;            else&#xA;            {&#xA;                // Log invalid page numbers&#xA;                status.Add(&#xA;                    string.Format(&#xA;                        &quot;Page {0}: Invalid page number&quot;,&#xA;                        pageNumber&#xA;                    )&#xA;                );&#xA;            }&#xA;        }&#xA;&#xA;        // Convert all log messages into a single string&#xA;        str_Status = string.Join(Environment.NewLine,status);&#xA;    }&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    // Return exception details back to UiPath&#xA;    str_Status = &quot;Error: &quot; + ex.Message;&#xA;}" DisplayName="Invoke code - Rotate Pdf" sap:VirtualizedContainerService.HintSize="452,403" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
